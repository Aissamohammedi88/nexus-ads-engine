                       created_at) VALUES (?,?,?,?,?,?)""",

                     (uid, account_id, email, role, api_key,

                      datetime.now().isoformat()))

        conn.commit()

        conn.close()

        audit("create_user", {"id": uid, "email": email})

        self._json({"id": uid, "api_key": api_key})



    def _create_campaign(self, b):


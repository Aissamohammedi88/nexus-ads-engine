<div class="b"><h2>Query Language</h2>

<textarea id="q">SELECT id, name, status FROM campaigns LIMIT 20</textarea>

<button onclick="runQ()">Execute</button>

<pre id="qOut"></pre></div>



<div class="b"><h2>Bidding</h2>

<textarea id="bq">{"base_bid_micros":1000000,"signals":{"quality_score":8,"ctr":0.04,"match_type":"EXACT","device":"DESKTOP","in_audience":true}}</textarea>

<button onclick="runB()">Compute</button>

<pre id="bOut"></pre></div>



<div class="b"><h2>Auction</h2>

<textarea id="aq">{"candidates":[{"ad_id":"a1","bid_micros":1000000,"quality_score":8,"expected_ctr":0.03},{"ad_id":"a2","bid_micros":800000,"quality_score":9,"expected_ctr":0.05}]}</textarea>

<button onclick="runA()">Run</button>

<pre id="aOut"></pre></div>



</div>

<script>

let TOKEN = '';

async function loadStats(){

  try{

    const r = await fetch('/api/status');

    const d = await r.json();

    const g = document.getElementById('stats');

    g.innerHTML='';

    Object.keys(d.counts).forEach(k=>{

      g.innerHTML += '<div class="st"><span class="n">'+d.counts[k]+'</span><span class="l">'+k+'</span></div>';

    });

  }catch(e){}

}

async function call(url, data, out, useToken){

  if(useToken === undefined) useToken = true;

  try{

    const opts = {method:'POST', headers:{'Content-Type':'application/json'}};

    if(useToken && TOKEN) opts.headers['Authorization'] = 'Bearer ' + TOKEN;

    if(data) opts.body = JSON.stringify(data);

    const r = await fetch(url, opts);

    const d = await r.json();

    document.getElementById(out).textContent = JSON.stringify(d, null, 2);

    return d;

  }catch(e){

    document.getElementById(out).textContent = 'ERROR ' + e;

    return null;

  }

}

async function login(){

  try{

    const d = JSON.parse(document.getElementById('logq').value);

    const r = await call('/api/login', d, 'logOut', false);

    if(r && r.api_key){ TOKEN = r.api_key; alert('Token : ' + TOKEN); }

  }catch(e){ document.getElementById('logOut').textContent = 'JSON invalide'; }

}

function runQ(){ call('/api/query',{query:document.getElementById('q').value},'qOut'); }

function runB(){ try{ call('/api/bid', JSON.parse(document.getElementById('bq').value),'bOut'); }catch(e){ document.getElementById('bOut').textContent='JSON invalide'; } }

function runA(){ try{ call('/api/auction', JSON.parse(document.getElementById('aq').value),'aOut'); }catch(e){ document.getElementById('aOut').textContent='JSON invalide'; } }

async function promouvoir(){

  const out = document.getElementById('promoOut');

  out.style.display = 'block';

  out.textContent = 'Creation de la campagne...';

  await call('/api/promote_figure_humain', {}, 'promoOut');

  loadStats();

}

loadStats();

</script></body></html>"""





class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):

    daemon_threads = True

    allow_reuse_address = True

    request_queue_size = 256





def seed():

    time.sleep(1)

    conn = db()

    cur = conn.cursor()

    cur.execute("SELECT COUNT(*) FROM accounts")

    deja_fait = cur.fetchone()[0] > 0



    if deja_fait:

        cur.execute("SELECT api_key FROM users WHERE role='ADMIN' LIMIT 1")

        row = cur.fetchone()

        conn.close()

        log("INFO", "Seed : deja fait")

        if row:

            print("")

            print(M + "=" * 64 + N)

            print(M + "  TOKEN ADMIN : " + row["api_key"] + N)

            print(M + "  UI : http://localhost:" + str(PORT) + "/" + N)

            print(M + "=" * 64 + N)

            print("")

        return



    conn.close()

    log("INFO", "Seed demo...")



    acc_id = nid("acc")

    conn = db()

    conn.execute("""INSERT INTO accounts (id, name, currency, timezone, created_at)

                   VALUES (?,?,?,?,?)""",

                 (acc_id, "Nexus Demo", "USD", "UTC", datetime.now().isoformat()))

    conn.commit()

    conn.close()



    uid = nid("usr")

    api_key = hashlib.sha256((uid + str(time.time())).encode()).hexdigest()[:32]

    conn = db()

    conn.execute("""INSERT INTO users (id, account_id, email, role, api_key, created_at)

                   VALUES (?,?,?,?,?,?)""",

                 (uid, acc_id, "aissa@nexus.dev", "ADMIN", api_key,

                  datetime.now().isoformat()))

    conn.commit()

    conn.close()

    log("OK", "Seed : user " + uid)



    cmp_id = promotion_figure_humain()

    if cmp_id:

        log("OK", "Seed : campagne " + cmp_id)

    else:

        log("WARN", "Seed : promotion echouee")



    print("")

    print(M + "=" * 64 + N)

    print(M + "  TOKEN ADMIN : " + api_key + N)

    print(M + "  UI : http://localhost:" + str(PORT) + "/" + N)

    print(M + "=" * 64 + N)

    print("")





def main():

    print("")

    print(C + "=" * 70 + N)

    print(C + "  NEXUS ADS ENGINE v" + ENGINE_VERSION + N)

    print(C + "  Cache + WAL + Auto-promo figure-humain." + N)

    print(C + "=" * 70 + N)



    if not check_lock():

        log("ERR", "Instance deja active. Arret.")

        sys.exit(1)



    init_db()

    backup_db()



    try:

        seed()

    except Exception as e:

        log("WARN", "Seed initial : " + str(e))



    log("INFO", "Starting HTTP server on port " + str(PORT))

    try:

        with Server((HOST, PORT), Handler) as httpd:

            log("OK", "Listening: http://127.0.0.1:" + str(PORT) + "/")

            log("INFO", "Public: / /health /api/status /api/login")

            log("INFO", "Auth:   Bearer <api_key> sur les autres routes")

            log("INFO", "Promo:  POST /api/promote_figure_humain")

            print("")

            httpd.serve_forever()

    except KeyboardInterrupt:

        log("INFO", "Stopped.")

    except OSError as e:

        log("ERR", "Port " + str(PORT) + " : " + str(e))

    finally:

        try:

            if LOCK_FILE.exists():

                LOCK_FILE.unlink()

        except Exception:

            pass





if __name__ == "__main__":

    main()

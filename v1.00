    def _create_keyword(self, b):

        ad_group_id = Validator.require_str(b, "ad_group_id")

        text = Validator.require_str(b, "text", 1, 200)

        kid = nid("kw")

        conn = db()

        conn.execute("""INSERT INTO keywords (id, ad_group_id, text, match_type,

                       status, quality_score, cpc_bid_micros, created_at)

                       VALUES (?,?,?,?,?,?,?,?)""",

                     (kid, ad_group_id, text, b.get("match_type", "BROAD"),

                      b.get("status", "ACTIVE"),

                      Validator.require_int(b, "quality_score", 0, 10),

                      Validator.require_int(b, "cpc_bid_micros", 0),

                      datetime.now().isoformat()))

        conn.commit()

        conn.close()

        self._json({"id": kid, "status": "created"})



    def _create_negative_keyword(self, b):

        text = Validator.require_str(b, "text")

        neg_id = nid("neg")

        conn = db()

        conn.execute("""INSERT INTO negative_keywords (id, campaign_id, ad_group_id,

                       text, match_type, created_at) VALUES (?,?,?,?,?,?)""",

                     (neg_id, b.get("campaign_id"), b.get("ad_group_id"), text,

                      b.get("match_type", "BROAD"), datetime.now().isoformat()))

        conn.commit()

        conn.close()

        self._json({"id": neg_id, "status": "created"})



    def _create_audience(self, b):

        account_id = Validator.require_str(b, "account_id")

        name = Validator.require_str(b, "name")

        aud = nid("aud")

        conn = db()

        conn.execute("""INSERT INTO audiences (id, account_id, name, type, size,

                       created_at) VALUES (?,?,?,?,?,?)""",

                     (aud, account_id, name, b.get("type", "CUSTOM"), 0,

                      datetime.now().isoformat()))

        conn.commit()

        conn.close()

        self._json({"id": aud, "status": "created"})



    def _add_audience_member(self, b):

        aid = Validator.require_str(b, "audience_id")

        raw = Validator.require_str(b, "user_id")

        h = hashlib.sha256(raw.encode()).hexdigest()

        conn = db()

        try:

            conn.execute("""INSERT OR IGNORE INTO audience_members

                           (audience_id, user_hash, added_at) VALUES (?,?,?)""",

                         (aid, h, datetime.now().isoformat()))

            conn.execute("UPDATE audiences SET size = size + 1 WHERE id=?", (aid,))

            conn.commit()

        except Exception:

            pass

        conn.close()

        self._json({"status": "added", "hash": h})



    def _create_targeting(self, b):

        ad_group_id = Validator.require_str(b, "ad_group_id")

        kind = Validator.require_str(b, "kind")

        value = Validator.require_str(b, "value")

        tid = nid("tgt")

        conn = db()

        conn.execute("""INSERT INTO targeting (id, ad_group_id, kind, value,

                       bid_modifier, created_at) VALUES (?,?,?,?,?,?)""",

                     (tid, ad_group_id, kind, value,

                      Validator.optional_float(b, "bid_modifier", 1.0),

                      datetime.now().isoformat()))

        conn.commit()

        conn.close()

        self._json({"id": tid, "status": "created"})



    def _record_metric(self, b):

        entity_type = Validator.require_str(b, "entity_type")

        entity_id = Validator.require_str(b, "entity_id")

        conn = db()

        conn.execute("""INSERT OR REPLACE INTO metrics (entity_type, entity_id, date,

                       hour, impressions, clicks, cost_micros, conversions,

                       revenue_micros) VALUES (?,?,?,?,?,?,?,?,?)""",

                     (entity_type, entity_id,

                      b.get("date", datetime.now().strftime("%Y-%m-%d")),

                      Validator.require_int(b, "hour", -1, 23),

                      Validator.require_int(b, "impressions", 0),

                      Validator.require_int(b, "clicks", 0),

                      Validator.require_int(b, "cost_micros", 0),

                      Validator.require_int(b, "conversions", 0),

                      Validator.require_int(b, "revenue_micros", 0)))

        conn.commit()

        conn.close()

        self._json({"status": "recorded"})



    def _run_auction(self, b):

        candidates = b.get("candidates", [])

        if not candidates:

            self._json({"error": "no candidates"}, 400)

            return

        auc_id = nid("auc")

        ranking = Auction().run(candidates)

        winner = ranking[0] if ranking else {}

        conn = db()

        conn.execute("""INSERT INTO auctions (id, query, request_json, response_json,

                       winner_ad_id, winner_bid_micros, created_at)

                       VALUES (?,?,?,?,?,?,?)""",

                     (auc_id, b.get("query", ""),

                      json.dumps(candidates, ensure_ascii=False),

                      json.dumps(ranking, ensure_ascii=False),

                      winner.get("ad_id", ""), winner.get("paid_micros", 0),

                      datetime.now().isoformat()))

        conn.commit()

        conn.close()

        self._json({"ok": True, "auction_id": auc_id, "ranking": ranking})



    def _query_post(self, b):

        q = b.get("query", "")

        if not q:

            self._json({"error": "missing query"}, 400)

            return

        try:

            rows = Query(q).execute()

            self._json({"ok": True, "rows": rows, "count": len(rows)})

        except Exception as e:

            self._json({"ok": False, "error": str(e)}, 400)



    def _compute_bid(self, b):

        base = Validator.require_int(b, "base_bid_micros", 1, 10**12)

        signals = b.get("signals", {})

        e = BiddingEngine()

        final = e.compute_bid(base, signals)

        self._json({"ok": True, "base": base, "final": final,

                    "explain": e.explain(base, signals)})



    def _smart_bid(self, b):

        camp = b.get("campaign", {})

        hc = Validator.require_int(b, "historical_cpa_micros", 0)

        tc = Validator.require_int(b, "target_cpa_micros", 0)

        new_budget = BiddingEngine().smart_bid(camp, hc, tc)

        self._json({"ok": True, "new_budget_micros": new_budget})



    def _record_click(self, b):

        cid = nid("clk")

        fraud = FraudDetector().check(b)

        if fraud["is_fraud"]:

            self._json({"status": "fraud_rejected", "fraud": fraud})

            return

        conn = db()

        conn.execute("""INSERT INTO clicks (id, ad_id, keyword_id, ip_hash,

                       user_agent, gclid, ts) VALUES (?,?,?,?,?,?,?)""",

                     (cid, b.get("ad_id", ""), b.get("keyword_id", ""),

                      b.get("ip_hash", ""), b.get("user_agent", "")[:200],

                      b.get("gclid", ""), datetime.now().isoformat()))

        conn.commit()

        conn.close()

        self._json({"status": "click_recorded", "click_id": cid, "fraud": fraud})



    def _record_conversion(self, b):

        cid = nid("cnv")

        conn = db()

        conn.execute("""INSERT INTO conversions (id, click_id, ad_id, value_micros, ts)

                       VALUES (?,?,?,?,?)""",

                     (cid, b.get("click_id", ""), b.get("ad_id", ""),

                      Validator.require_int(b, "value_micros", 0),

                      datetime.now().isoformat()))

        conn.commit()

        conn.close()

        self._json({"status": "conversion_recorded", "conversion_id": cid})



    def _attribute(self, b):

        clicks = b.get("clicks", [])

        value = Validator.require_int(b, "value_micros", 0)

        model = b.get("model", "last_click")

        a = Attribution()

        if model == "last_click":

            r = a.last_click(clicks)

        elif model == "linear":

            r = a.linear(clicks, value)

        elif model == "time_decay":

            r = a.time_decay(clicks, value,

                             Validator.optional_float(b, "half_life_hours", 24.0))

        else:

            r = {"error": "unknown model"}

        self._json({"model": model, "attribution": r})



    def _fraud_check(self, b):

        self._json(FraudDetector().check(b))



    def _promote(self, b):

        cmp_id = promotion_figure_humain()

        if cmp_id:

            conn = db()

            cur = conn.cursor()

            cur.execute("""SELECT COUNT(*) FROM ads WHERE ad_group_id IN

                           (SELECT id FROM ad_groups WHERE campaign_id=?)""", (cmp_id,))

            nb_ads = cur.fetchone()[0]

            cur.execute("""SELECT COUNT(*) FROM keywords WHERE ad_group_id IN

                           (SELECT id FROM ad_groups WHERE campaign_id=?)""", (cmp_id,))

            nb_kw = cur.fetchone()[0]

            conn.close()

            self._json({"ok": True, "projet": PROJET_NOM, "url": PROJET_URL,

                        "campaign_id": cmp_id, "nb_ads": nb_ads, "nb_keywords": nb_kw})

        else:

            self._json({"error": "no account, create one first"}, 400)






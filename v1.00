.hl{background:#14001f;border:2px solid #c8a45c;border-radius:10px;padding:20px;margin-bottom:20px;text-align:center}

</style></head><body><div class="c">

<h1>Nexus Ads Engine v3.4</h1>

<p class="s">Auth API. Cache. Auto-promo figure-humain.</p>



<div class="hl">

<h2 style="color:#c8a45c;font-size:16px;margin-bottom:12px">PROJET A PROMOUVOIR</h2>

<p style="font-size:14px;margin-bottom:8px"><strong>Figure-Humain</strong></p>

<p style="font-size:12px;color:#888;margin-bottom:14px">github.com/Aissamohammedi88/figure-humain</p>

<button class="promo" onclick="promouvoir()">Lancer la campagne auto</button>


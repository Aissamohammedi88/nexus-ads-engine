.st .l{font-size:9px;color:#888;text-transform:uppercase;letter-spacing:1px;margin-top:4px;display:block}

.b{background:#14001f;border:1px solid #2a1a3a;border-radius:10px;padding:18px;margin-bottom:14px}

.b h2{color:#c8a45c;font-size:14px;margin-bottom:10px}


class Handler(http.server.BaseHTTPRequestHandler):

    protocol_version = "HTTP/1.1"



    def log_message(self, *args):

        pass



    def _client_ip(self):

        return self.client_address[0] if self.client_address else "?"



    def _check_rate(self):

        allowed, count = RATE_LIMITER.check(self._client_ip())

        if not allowed:

            self._json({"error": "rate_limited", "count": count}, 429)

            return False

        return True



    def _check_auth(self, path):

        ok, info = AUTH.check(self.headers, path)

        if not ok:

            self._json({"error": "unauthorized", "reason": info}, 401)

            return False

        return True



    def _json(self, data, code=200):

        body = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")

        self.send_response(code)

        self.send_header("Content-Type", "application/json; charset=utf-8")

        self.send_header("Content-Length", str(len(body)))

        self.send_header("Access-Control-Allow-Origin", "*")

        self.send_header("X-Powered-By", "NexusAds/" + ENGINE_VERSION)

        self.end_headers()

        try:

            self.wfile.write(body)

        except Exception:

            pass



    def _html(self, content, code=200):

        body = content.encode("utf-8")

        self.send_response(code)

        self.send_header("Content-Type", "text/html; charset=utf-8")

        self.send_header("Content-Length", str(len(body)))

        self.end_headers()

        try:

            self.wfile.write(body)

        except Exception:

            pass



    def _read_json(self):

        try:

            n = int(self.headers.get("Content-Length", 0))

            if n == 0:

                return {}

            return json.loads(self.rfile.read(n).decode("utf-8"))

        except Exception:

            return {}



    def do_GET(self):

        if not self._check_rate():

            return

        p = urlparse(self.path)

        path = p.path

        qs = parse_qs(p.query)



        if path == "/health":

            self._json({"status": "ok", "time": datetime.now().isoformat(),

                        "version": ENGINE_VERSION})

            return

        if path in ("/", "/index.html"):

            self._html(HTML_PAGE)

            return

        if path == "/api/status":

            self._status()

            return



        if not self._check_auth(path):

            return



        if path == "/api/query":

            self._query_get(qs)

        elif path == "/api/counts":

            self._counts()

        elif path == "/api/report":

            self._report(qs)

        elif path == "/api/timeline":

            self._timeline(qs)

        else:

            self._json({"error": "not found", "path": path}, 404)



    def _status(self):

        now = time.time()

        with STATUS_CACHE_LOCK:

            if STATUS_CACHE["data"] and (now - STATUS_CACHE["ts"]) < STATUS_CACHE_TTL:

                self._json(STATUS_CACHE["data"])

                return



        conn = db()

        cur = conn.cursor()

        counts = {}

        for t in ALLOWED_TABLES.keys():

            try:

                cur.execute("SELECT COUNT(*) FROM " + t)

                counts[t] = cur.fetchone()[0]

            except Exception:

                counts[t] = -1

        conn.close()



        data = {"engine": "NexusAds", "version": ENGINE_VERSION,

                "counts": counts, "time": datetime.now().isoformat()}



        with STATUS_CACHE_LOCK:

            STATUS_CACHE["data"] = data

            STATUS_CACHE["ts"] = now



        self._json(data)



    def _counts(self):

        conn = db()

        cur = conn.cursor()

        out = {}

        for t in ALLOWED_TABLES.keys():

            try:

                cur.execute("SELECT COUNT(*) FROM " + t)

                out[t] = cur.fetchone()[0]

            except Exception:

                out[t] = -1

        conn.close()

        self._json(out)



    def _query_get(self, qs):

        q = qs.get("q", [""])[0]

        if not q:

            self._json({"error": "missing q"}, 400)

            return

        try:

            rows = Query(q).execute()

            self._json({"ok": True, "rows": rows, "count": len(rows)})

        except Exception as e:

            self._json({"ok": False, "error": str(e)}, 400)



    def _report(self, qs):

        et = qs.get("type", ["campaign"])[0]

        eid = qs.get("id", [""])[0]

        sd = qs.get("start", [(datetime.now() - timedelta(days=30)).strftime("%Y-%m-%d")])[0]

        ed = qs.get("end", [datetime.now().strftime("%Y-%m-%d")])[0]

        self._json(Reporting().summarize(et, eid, sd, ed))



    def _timeline(self, qs):

        et = qs.get("type", ["campaign"])[0]

        eid = qs.get("id", [""])[0]

        days = int(qs.get("days", ["30"])[0])

        r = Reporting().timeline(et, eid, days)

        self._json({"rows": r, "count": len(r)})



    def do_POST(self):

        if not self._check_rate():

            return

        p = urlparse(self.path)

        path = p.path



        if path == "/api/login":

            b = self._read_json()

            email = b.get("email", "")

            conn = db()

            cur = conn.cursor()

            cur.execute("SELECT id, api_key, role FROM users WHERE email=?", (email,))

            row = cur.fetchone()

            conn.close()

            if row:

                self._json({"ok": True, "user_id": row["id"],

                            "api_key": row["api_key"], "role": row["role"]})

            else:

                self._json({"ok": False, "error": "user not found"}, 404)

            return



        if not self._check_auth(path):

            return

        body = self._read_json()



        routes = {

            "/api/accounts": self._create_account,

            "/api/users": self._create_user,

            "/api/campaigns": self._create_campaign,

            "/api/ad_groups": self._create_ad_group,

            "/api/ads": self._create_ad,

            "/api/keywords": self._create_keyword,

            "/api/negative_keywords": self._create_negative_keyword,

            "/api/audiences": self._create_audience,

            "/api/audience_members": self._add_audience_member,

            "/api/targeting": self._create_targeting,

            "/api/metrics": self._record_metric,

            "/api/auction": self._run_auction,

            "/api/query": self._query_post,

            "/api/bid": self._compute_bid,

            "/api/smart_bid": self._smart_bid,

            "/api/click": self._record_click,

            "/api/conversion": self._record_conversion,

            "/api/attribute": self._attribute,

            "/api/fraud_check": self._fraud_check,

            "/api/promote_figure_humain": self._promote,

        }



        fn = routes.get(path)

        if fn:

            try:

                fn(body)

            except ValueError as e:

                self._json({"error": "validation", "detail": str(e)}, 400)

            except Exception as e:

                log("ERR", path + " : " + str(e))

                self._json({"error": str(e)}, 500)

        else:

            self._json({"error": "not found", "path": path}, 404)



    def _create_account(self, b):

        name = Validator.require_str(b, "name", 1, 200)

        aid = nid("acc")

        conn = db()

        conn.execute("""INSERT INTO accounts (id, name, currency, timezone, created_at)

                       VALUES (?,?,?,?,?)""",

                     (aid, name, b.get("currency", "USD"),

                      b.get("timezone", "UTC"), datetime.now().isoformat()))

        conn.commit()

        conn.close()

        audit("create_account", {"id": aid, "name": name})

        self._json({"id": aid, "status": "created"})



    def _create_user(self, b):

        account_id = Validator.require_str(b, "account_id")

        email = Validator.require_str(b, "email", 3, 200)

        role = Validator.optional_str(b, "role", "VIEWER")


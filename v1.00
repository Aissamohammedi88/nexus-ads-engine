class Query:

    def __init__(self, raw):

        self.raw = raw.strip()

        self.select = []

        self.frm = None

        self.where = []

        self.order = None

        self.limit = None

        self._parse()



    def _parse(self):

        s = self.raw

        up = s.upper()

        if " FROM " not in up:

            raise ValueError("Missing FROM clause")

        i = up.index(" FROM ")

        select_part = s[:i].strip()

        rest = s[i + 6:].strip()

        if not select_part.upper().startswith("SELECT"):

            raise ValueError("Must start with SELECT")

        fields = select_part[6:].strip()

        self.select = ["*"] if fields == "*" else [f.strip() for f in fields.split(",")]

        kws = [" WHERE ", " ORDER BY ", " LIMIT ", " GROUP BY "]

        pos = {}

        for kw in kws:

            idx = rest.upper().find(kw)

            if idx != -1:

                pos[kw] = idx

        if not pos:

            self.frm = rest.strip()

        else:

            first = min(pos.values())

            self.frm = rest[:first].strip()

            if " WHERE " in pos:

                start = pos[" WHERE "] + 7

                ends = [p for k, p in pos.items() if k != " WHERE " and p > pos[" WHERE "]]

                end = min(ends) if ends else len(rest)

                self.where = self._parse_where(rest[start:end].strip())

            if " ORDER BY " in pos:

                start = pos[" ORDER BY "] + 10

                ends = [p for k, p in pos.items() if k != " ORDER BY " and p > pos[" ORDER BY "]]

                end = min(ends) if ends else len(rest)

                self.order = rest[start:end].strip()

            if " LIMIT " in pos:

                start = pos[" LIMIT "] + 7

                try:

                    self.limit = int(rest[start:].strip().split()[0])

                except Exception:

                    self.limit = None

        if self.frm not in ALLOWED_TABLES:

            raise ValueError("Unknown table: " + self.frm)

        for f in self.select:

            if f != "*" and f not in ALLOWED_TABLES[self.frm]:

                raise ValueError("Unknown field: " + f)



    def _parse_where(self, clause):

        conds = []

        for part in clause.split(" AND "):

            for op in [">=", "<=", "!=", "=", ">", "<"]:

                if op in part:

                    field, value = part.split(op, 1)

                    field = field.strip()

                    value = value.strip().strip("'\"")

                    if field not in ALLOWED_TABLES[self.frm]:

                        raise ValueError("Unknown field: " + field)

                    conds.append((field, op, value))

                    break

        return conds



    def execute(self):

        conn = db()

        cur = conn.cursor()

        sql = "SELECT "

        sql += "*" if self.select == ["*"] else ", ".join(self.select)

        sql += " FROM " + self.frm

        params = []

        if self.where:

            clauses = []

            for f, op, v in self.where:

                clauses.append(f + " " + op + " ?")

                params.append(v)

            sql += " WHERE " + " AND ".join(clauses)

        if self.order:

            sql += " ORDER BY " + self.order

        if self.limit:

            sql += " LIMIT ?"

            params.append(self.limit)

        try:

            cur.execute(sql, params)

            rows = [dict(r) for r in cur.fetchall()]

        except Exception as e:

            conn.close()

            raise ValueError("SQL error: " + str(e))

        conn.close()

        return rows





class BiddingEngine:

    def compute_bid(self, base_bid_micros, signals):

        bid = float(base_bid_micros)

        qs = signals.get("quality_score", 5)

        bid *= (0.5 + qs / 10.0)

        ctr = signals.get("ctr", 0.0)

        if ctr > 0.05:

            bid *= 1.25

        elif ctr > 0.02:

            bid *= 1.1

        elif ctr < 0.01:

            bid *= 0.8

        mt = signals.get("match_type", "BROAD")

        if mt == "EXACT":

            bid *= 1.3

        elif mt == "PHRASE":

            bid *= 1.1

        h = datetime.now().hour

        if 9 <= h <= 17:

            bid *= 1.1

        elif 0 <= h <= 5:

            bid *= 0.7

        if datetime.now().weekday() >= 5:

            bid *= 0.9

        device = signals.get("device", "MOBILE")

        if device == "DESKTOP":

            bid *= 1.15

        elif device == "TABLET":

            bid *= 0.95

        if signals.get("in_audience"):

            bid *= 1.2

        convs = signals.get("past_conversions", 0)

        if convs >= 10:

            bid *= 1.3

        elif convs >= 3:

            bid *= 1.1

        return int(bid)



    def explain(self, base_bid_micros, signals):

        parts = ["base=" + str(base_bid_micros),

                 "qs=" + str(signals.get("quality_score", 5)),

                 "ctr=" + str(round(signals.get("ctr", 0.0), 4)),

                 "match=" + str(signals.get("match_type", "BROAD")),

                 "device=" + str(signals.get("device", "MOBILE"))]

        final = self.compute_bid(base_bid_micros, signals)

        parts.append("final=" + str(final))

        return " | ".join(parts)



    def smart_bid(self, campaign, historical_cpa_micros, target_cpa_micros):

        if target_cpa_micros <= 0:

            return campaign.get("budget_micros", 0)

        ratio = float(target_cpa_micros) / max(1.0, float(historical_cpa_micros))

        return max(0, int(campaign.get("budget_micros", 0) * ratio))





class Auction:

    def run(self, candidates):

        scored = []

        for c in candidates:

            bid = int(c.get("bid_micros", 0))

            qs = float(c.get("quality_score", 5))

            ctr = float(c.get("expected_ctr", 0.01))

            audience = 1.2 if c.get("in_audience") else 1.0

            quality_factor = 0.5 + qs / 10.0

            ctr_factor = 1.0 + (ctr * 10.0)

            score = int(bid * quality_factor * ctr_factor * audience)

            scored.append({"ad_id": c["ad_id"], "score": score, "bid_micros": bid,

                           "quality_score": qs, "expected_ctr": ctr,

                           "in_audience": bool(c.get("in_audience"))})

        scored.sort(key=lambda x: x["score"], reverse=True)

        for i, s in enumerate(scored):

            s["rank"] = i + 1

        if len(scored) >= 2:

            w = scored[0]

            s = scored[1]

            paid = int(s["score"] / (0.5 + w["quality_score"] / 10.0) / (1.0 + w["expected_ctr"] * 10.0))

            w["paid_micros"] = max(1, paid)

        elif scored:

            scored[0]["paid_micros"] = 1

        return scored





class FraudDetector:

    def __init__(self):

        self._cache = {}

        self._lock = threading.Lock()



    def check(self, click):

        score = 0.0

        reasons = []

        ip = click.get("ip_hash", "")

        ua = click.get("user_agent", "")

        key = "ip:" + ip

        with self._lock:

            self._cache[key] = self._cache.get(key, 0) + 1

            count = self._cache[key]

        if count > 10:

            score += 0.5

            reasons.append("ip_burst")

        ua_l = ua.lower()

        for sig in ["bot", "crawler", "spider", "headless", "phantom"]:

            if sig in ua_l:

                score += 0.6

                reasons.append("ua_bot_" + sig)

                break

        if not ua.strip():

            score += 0.3

            reasons.append("empty_ua")

        if len(ua) < 20:

            score += 0.2

            reasons.append("short_ua")

        return {"fraud_score": round(min(1.0, score), 3),

                "reasons": reasons, "is_fraud": score >= 0.6}





class RateLimiter:

    def __init__(self, window_sec=60, max_requests=10000):

        self.window = window_sec

        self.max = max_requests

        self._buckets = {}

        self._lock = threading.Lock()



    def check(self, key):

        now = int(time.time())

        with self._lock:

            b = self._buckets.setdefault(key, [])

            b[:] = [t for t in b if now - t < self.window]

            if len(b) >= self.max:

                return False, len(b)

            b.append(now)

            return True, len(b)





RATE_LIMITER = RateLimiter()





class Attribution:

    def last_click(self, clicks):

        if not clicks:

            return None

        return sorted(clicks, key=lambda c: c.get("ts", ""), reverse=True)[0]



    def linear(self, clicks, value_micros):

        if not clicks:

            return {}

        share = int(value_micros / len(clicks))

        return {c["id"]: share for c in clicks}



    def time_decay(self, clicks, value_micros, half_life_hours=24.0):

        if not clicks:

            return {}

        now = datetime.now()

        weights = {}

        for c in clicks:

            try:

                ts = datetime.fromisoformat(c["ts"])

            except Exception:

                ts = now

            age = max(0.0, (now - ts).total_seconds() / 3600.0)

            weights[c["id"]] = 0.5 ** (age / half_life_hours)

        total = sum(weights.values()) or 1.0

        return {k: int(value_micros * v / total) for k, v in weights.items()}





class Reporting:

    def summarize(self, entity_type, entity_id, start_date, end_date):

        conn = db()

        cur = conn.cursor()

        cur.execute("""

            SELECT SUM(impressions) AS impr, SUM(clicks) AS clicks,

                   SUM(cost_micros) AS cost, SUM(conversions) AS conv,

                   SUM(revenue_micros) AS rev

            FROM metrics WHERE entity_type=? AND entity_id=? AND date>=? AND date<=?

        """, (entity_type, entity_id, start_date, end_date))

        row = cur.fetchone()

        conn.close()

        d = dict(row) if row else {}

        impr = d.get("impr") or 0

        clicks = d.get("clicks") or 0

        cost = d.get("cost") or 0

        conv = d.get("conv") or 0

        rev = d.get("rev") or 0

        return {"impressions": impr, "clicks": clicks, "cost_micros": cost,

                "conversions": conv, "revenue_micros": rev,

                "ctr": round((clicks / impr) if impr else 0.0, 6),

                "cpc_micros": int((cost / clicks) if clicks else 0),

                "cpa_micros": int((cost / conv) if conv else 0),

                "roas": round((rev / cost) if cost else 0.0, 4)}



    def timeline(self, entity_type, entity_id, days=30):

        conn = db()

        cur = conn.cursor()

        start = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d")

        cur.execute("""

            SELECT date, SUM(impressions) AS impr, SUM(clicks) AS clicks,

                   SUM(cost_micros) AS cost, SUM(conversions) AS conv,

                   SUM(revenue_micros) AS rev

            FROM metrics WHERE entity_type=? AND entity_id=? AND date>=?

            GROUP BY date ORDER BY date ASC

        """, (entity_type, entity_id, start))

        rows = [dict(r) for r in cur.fetchall()]

        conn.close()

        return rows






CREATE INDEX IF NOT EXISTS idx_metric_entity ON metrics(entity_type, entity_id, date);

"""





def db():

    conn = sqlite3.connect(DB_PATH, timeout=30, check_same_thread=False)

    conn.row_factory = sqlite3.Row

    conn.execute("PRAGMA busy_timeout = 30000")

    conn.execute("PRAGMA journal_mode = WAL")

    conn.execute("PRAGMA synchronous = NORMAL")

    conn.execute("PRAGMA cache_size = -64000")

    conn.execute("PRAGMA temp_store = MEMORY")

    return conn





def init_db():

    conn = db()

    conn.executescript(SCHEMA)

    conn.commit()

    conn.close()

    log("OK", "DB initialized: " + str(DB_PATH))





def backup_db():

    if DB_PATH.exists():

        ts = datetime.now().strftime("%Y%m%d_%H%M%S")

        target = BACKUP_DIR / ("ads_" + ts + ".db")

        try:

            shutil.copy2(DB_PATH, target)

            log("OK", "Backup : " + target.name)

            backups = sorted(BACKUP_DIR.glob("ads_*.db"))

            for old in backups[:-5]:

                old.unlink()

        except Exception as e:

            log("WARN", "Backup echoue : " + str(e))





def nid(prefix):

    return prefix + "_" + uuid.uuid4().hex[:16]





STATUS_CACHE = {"data": None, "ts": 0}

STATUS_CACHE_LOCK = threading.Lock()

STATUS_CACHE_TTL = 2



AUTH_CACHE = {}

AUTH_CACHE_LOCK = threading.Lock()

AUTH_CACHE_TTL = 5





class Validator:

    @staticmethod

    def require_str(obj, key, min_len=1, max_len=500):

        v = obj.get(key)

        if not isinstance(v, str) or len(v) < min_len or len(v) > max_len:

            raise ValueError("Champ '" + key + "' : string requis")

        return v.strip()



    @staticmethod

    def require_int(obj, key, min_val=0, max_val=10**12):

        v = obj.get(key, 0)

        try:

            v = int(v)

        except Exception:

            raise ValueError("Champ '" + key + "' : entier requis")

        if v < min_val or v > max_val:

            raise ValueError("Champ '" + key + "' hors limites")

        return v



    @staticmethod

    def optional_str(obj, key, default="", max_len=500):

        v = obj.get(key, default)

        if v is None:

            v = default

        if not isinstance(v, str):

            v = str(v)

        return v[:max_len]



    @staticmethod

    def optional_float(obj, key, default=0.0):

        v = obj.get(key, default)

        try:

            return float(v)

        except Exception:

            return default





class Auth:

    def __init__(self):

        self.public_routes = ["/", "/index.html", "/health",

                              "/api/status", "/api/login"]



    def check(self, headers, path):

        if path in self.public_routes:

            return True, "public"

        auth_header = headers.get("Authorization", "")

        if not auth_header.startswith("Bearer "):

            return False, "missing_token"

        token = auth_header[7:].strip()



        now = time.time()

        with AUTH_CACHE_LOCK:

            cached = AUTH_CACHE.get(token)

            if cached and (now - cached["ts"]) < AUTH_CACHE_TTL:

                return True, cached["user"]



        conn = db()

        cur = conn.cursor()

        cur.execute("SELECT id, role FROM users WHERE api_key=?", (token,))

        row = cur.fetchone()

        conn.close()

        if not row:

            return False, "invalid_token"

        user = dict(row)



        with AUTH_CACHE_LOCK:

            AUTH_CACHE[token] = {"user": user, "ts": now}

        return True, user





AUTH = Auth()





